CONFIG_IDF_TARGET="esp32s3"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
# Messages over the USB-C port (no UART adapter needed): `idf.py monitor`
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Wake-time and power: see README ("Battery and wake-speed design")
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_SYSTEM_BROWNOUT_DET=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# The main task does the drawing, ledger scan and settings load on its own stack: the default 3.5 KB is too small
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
